# =============================================================================
# hgraph_platform_tools — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# Never commit .env to version control.
# =============================================================================

# --- SMTP / Email ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=
RECIPIENT_EMAIL=

# --- Database ---
ENTITLEMENTS_DB_PATH=hgraph_entitlements.db
STATIC_DATA_DB_PATH=static_data.db

# --- API ---
STATIC_DATA_API_URL=http://localhost:8080/api/counterparties

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Trade Messaging ---
MESSAGE_SENDER_ID=hgraph_platform
MESSAGE_TARGET_ID=booking_system
MESSAGE_VERSION=1.0

# --- Notification Templates ---
NOTIFICATION_TEMPLATE_DIR=hgraph_notification/templates

# --- OMS API authentication ---
# token (default): requests must send "Authorization: Bearer <token>", an HS256 JWT
#   signed with API_AUTH_SECRET. Mint one with: hgraph-tools api-token <user_id>
# dev: the X-User-Id header is trusted without verification. Local development only.
API_AUTH_MODE=token
# At least 32 characters. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_AUTH_SECRET=
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
