# =============================================================================
# hgraph_platform_tools — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# Never commit .env to version control.
# =============================================================================

# --- SMTP / Email ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=
RECIPIENT_EMAIL=

# --- Database ---
ENTITLEMENTS_DB_PATH=hgraph_entitlements.db
STATIC_DATA_DB_PATH=static_data.db

# --- API ---
STATIC_DATA_API_URL=http://localhost:8080/api/counterparties

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Trade Messaging ---
MESSAGE_SENDER_ID=hgraph_platform
MESSAGE_TARGET_ID=booking_system
MESSAGE_VERSION=1.0

# --- Notification Templates ---
NOTIFICATION_TEMPLATE_DIR=hgraph_notification/templates

# --- Trades booked from order fills ---
# Our own legal entity on booked trades
INTERNAL_PARTY_ID=INTERNAL
# Where booked trade files are written (default: <db-dir>/booked_trades)
TRADE_OUTPUT_DIR=
# Kafka topic booked trades are published to; leave empty to disable delivery
TRADE_KAFKA_TOPIC=

# --- AI order parsing ---
# Claude model used by POST /api/v1/orders/parse-nlp (default: claude-opus-5-5)
ORDER_PARSER_MODEL=

# --- API authentication ---
# header: trust the X-User-Id header (development only). oidc: require bearer tokens.
AUTH_MODE=header
# Identity provider's issuer URL and the audience this API is registered as (required for oidc)
OIDC_ISSUER=
OIDC_AUDIENCE=
# Token claim used as the user ID (default: sub); must match the IDs in the entitlements store
OIDC_USER_CLAIM=
# Signing keys URL (default: read from the issuer's discovery document)
OIDC_JWKS_URL=

# --- MCP server sign-in (when the API uses AUTH_MODE=oidc) ---
# Client credentials for the agent's own service account...
OMS_TOKEN_URL=
OMS_CLIENT_ID=
OMS_CLIENT_SECRET=
OMS_TOKEN_SCOPE=
OMS_TOKEN_AUDIENCE=
# ...or a fixed bearer token
OMS_API_TOKEN=

# --- Order core database ---
# PostgreSQL URL for the order log, trade bookings and proposals, e.g.
# postgresql://oms:password@localhost:5432/oms
# Leave empty to keep them in SQLite files in the API's database directory
DATABASE_URL=

# --- Tenancy (one deployment per customer) ---
# The customer this deployment serves; leave empty for a single-tenant deployment
TENANT_ID=
# PostgreSQL schema for the order data (default: tenant_<TENANT_ID> when TENANT_ID is set)
DATABASE_SCHEMA=
# Token claim that must equal TENANT_ID, when customers share an identity provider (e.g. tid, org_id)
OIDC_TENANT_CLAIM=
